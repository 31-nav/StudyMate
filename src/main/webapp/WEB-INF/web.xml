<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>StudyMate</display-name>
    <description>Your Learning. Your Space. - Modern Learning Management System</description>

    <!-- Context Listeners -->
    <listener>
        <listener-class>com.studymate.config.AppContextListener</listener-class>
    </listener>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
            <name>STUDYMATE_JSESSIONID</name>
            <comment>StudyMate Authentication Session</comment>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Filters -->
    <!-- 1. Security Headers Filter -->
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.studymate.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. CSRF Protection Filter -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.studymate.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 3. Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.studymate.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/student/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/superadmin/*</url-pattern>
        <url-pattern>/resources/download/*</url-pattern>
    </filter-mapping>

    <!-- 4. Authorization Filter -->
    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>com.studymate.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/superadmin/*</url-pattern>
    </filter-mapping>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Custom Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/errors/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/errors/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/errors/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/errors/500.jsp</location>
    </error-page>

</web-app>
