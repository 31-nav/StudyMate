# ==============================================================================
# StudyMate - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set system environment variables accordingly.
# Do NOT commit production secrets or credentials to version control.

# Application Identity & URLs
APP_NAME=StudyMate
APP_TAGLINE=Your Learning. Your Space.
APP_ENV=development
APP_BASE_URL=http://localhost:8080/studymate
FRONTEND_URL=http://localhost:8080/studymate
APP_SECRET=studymate_secure_dev_secret_key_change_in_production_min_32_chars

# Database Configuration (PostgreSQL)
DB_DRIVER=org.postgresql.Driver
DATABASE_URL=jdbc:postgresql://localhost:5432/studymate
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_TIMEOUT_MS=30000

# Hibernate Specifics
HIBERNATE_HBM2DDL_AUTO=update
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=true

# Jakarta Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@studymate.edu
MAIL_PASSWORD=your_secure_smtp_app_password
MAIL_FROM=StudyMate <notifications@studymate.edu>
MAIL_AUTH=true
MAIL_STARTTLS=true
# When MAIL_DEV_MODE is true, emails are stored locally and logged without requiring an active external SMTP relay
MAIL_DEV_MODE=true

# File Storage Configuration (Uploaded files are kept outside web root)
STORAGE_PATH=C:/StudyMate/storage/uploads
# Maximum file upload size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# Security and Session Settings
SESSION_TIMEOUT_MINUTES=60
CSRF_PROTECTION_ENABLED=true
PASSWORD_RESET_TOKEN_VALIDITY_HOURS=2
EMAIL_VERIFICATION_TOKEN_VALIDITY_HOURS=24
ADMIN_INVITATION_TOKEN_VALIDITY_HOURS=48

